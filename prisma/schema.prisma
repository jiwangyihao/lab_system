
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

// ========== 用户模块 ==========
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  phone     String?
  email     String?
  role      Role     @default(STUDENT)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  student      Student?
  teacher      Teacher?
  outsider     Outsider?
  reservations Reservation[]
  checkIns     CheckIn[]
  incidents    Incident[]
  purchaseRequests PurchaseRequest[] @relation("PurchaseApplicant")
  purchaseRequestsHandled PurchaseRequest[] @relation("PurchaseTargetAdmin")
  equipmentsManaged Equipment[] @relation("EquipmentAdmin")
  scrapRequests    ScrapRequest[]
}

enum Role {
  STUDENT   // 学生
  TEACHER   // 教师
  OUTSIDER  // 校外人员
  ADMIN     // 设备管理员
  HEAD      // 实验室负责人
}

model Student {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id])
  studentNo String   @unique
  major     String
  className String
  tutorId   String?
  tutor     Teacher? @relation(fields: [tutorId], references: [userId])
}

model Teacher {
  userId     String    @id
  user       User      @relation(fields: [userId], references: [id])
  teacherNo  String    @unique
  title      String
  department String
  students   Student[]
}

model Outsider {
  userId  String @id
  user    User   @relation(fields: [userId], references: [id])
  idCard  String
  company String
  balance Float  @default(0)
}

// ========== 设备模块 ==========
model Equipment {
  id              String          @id @default(cuid())
  name            String
  adminId         String?
  admin           User?           @relation("EquipmentAdmin", fields: [adminId], references: [id])
  model           String
  manufacturer    String
  purchaseDate    DateTime
  status          EquipmentStatus @default(AVAILABLE)
  rentalPrice     Float           @default(0)
  maintenanceCycle Int?           // 检修周期(天)

  maintenanceLogs MaintenanceLog[]
  reservations    Reservation[]
  timeSlots       EquipmentTimeSlot[]
  checkIns        CheckIn[]
  scrapRequests   ScrapRequest[]
  incidents       Incident[]
}

enum EquipmentStatus {
  AVAILABLE       // 空闲
  OCCUPIED        // 占用
  MAINTENANCE     // 维修中
  SCRAP_REQUESTED // 报废申请中 (新增)
  SCRAPPED        // 已报废
}

model EquipmentTimeSlot {
  id          String    @id @default(cuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  dayOfWeek   Int?      // 0-6, null表示特定日期
  specificDate DateTime? // 特定日期
  startTime   String    // "08:00"
  endTime     String    // "22:00"
  isAvailable Boolean   @default(true)
}

model MaintenanceLog {
  id          String    @id @default(cuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  content     String
  logDate     DateTime  @default(now())
  operator    String
}

// ========== 预约模块 ==========
model Reservation {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id])
  equipmentId  String
  equipment    Equipment         @relation(fields: [equipmentId], references: [id])
  startTime    DateTime
  endTime      DateTime
  usageDesc    String
  status       ReservationStatus @default(PENDING_TEACHER)
  rejectReason String?
  createdAt    DateTime          @default(now())

  payment  Payment?
  checkIns CheckIn[]
}

enum ReservationStatus {
  PENDING_TEACHER   // 待导师审批 (学生)
  PENDING_ADMIN     // 待管理员审批
  PENDING_HEAD      // 待负责人审批 (校外)
  PENDING_PAYMENT   // 待缴费 (校外)
  APPROVED          // 已批准
  REJECTED          // 已驳回
  CANCELLED         // 已撤销
  IN_USE            // 使用中
  COMPLETED         // 已完成
}

model Payment {
  id            String      @id @default(cuid())
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  amount        Float
  paidAt        DateTime?
  method        String?
  isRefunded    Boolean     @default(false)
}

// ========== 实验监管模块 ==========
model CheckIn {
  id            String       @id @default(cuid())
  reservationId String
  reservation   Reservation  @relation(fields: [reservationId], references: [id])
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  equipmentId   String
  equipment     Equipment    @relation(fields: [equipmentId], references: [id])
  checkInTime   DateTime?
  checkOutTime  DateTime?
  notes         String?
}

model Incident {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  equipmentId String?
  equipment   Equipment? @relation(fields: [equipmentId], references: [id])
  title       String
  description String
  severity    String   // LOW, MEDIUM, HIGH
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  createdAt   DateTime @default(now())
}

// ========== 系统设置模块 ==========
model SystemConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String
  desc  String?
}

model ExperimentPlan {
  id          String   @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  targetUsers String?  // JSON: ["STUDENT", "TEACHER"]
  createdAt   DateTime @default(now())
}

model Regulation {
  id        String   @id @default(cuid())
  title     String
  content   Json     // Nested Ordered List
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model IpWhitelist {
  id        String   @id @default(cuid())
  ipAddress String
  desc      String?
  createdAt DateTime @default(now())
}

// ========== 报表模块 ==========
model Report {
  id           String   @id @default(cuid())
  type         String   // WEEKLY, MONTHLY, YEARLY
  periodStart  DateTime
  periodEnd    DateTime
  contentJson  Json
  generatedAt  DateTime @default(now())
}

// ========== 负责人管理模块 (Phase 4) ==========
enum RequestStatus {
  PENDING   // 待审批 (待管理员)
  PENDING_HEAD // 待负责人审批
  APPROVED  // 已通过
  REJECTED  // 已驳回
}

model PurchaseRequest {
  id            String        @id @default(cuid())
  applicantId   String
  applicant     User          @relation("PurchaseApplicant", fields: [applicantId], references: [id])
  targetAdminId String?
  targetAdmin   User?         @relation("PurchaseTargetAdmin", fields: [targetAdminId], references: [id])
  name          String
  model         String
  quantity      Int
  budget        Float
  reason        String
  status        RequestStatus @default(PENDING)
  rejectReason  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model ScrapRequest {
  id            String        @id @default(cuid())
  equipmentId   String
  equipment     Equipment     @relation(fields: [equipmentId], references: [id])
  applicantId   String
  applicant     User          @relation(fields: [applicantId], references: [id])
  reason        String
  status        RequestStatus @default(PENDING)
  rejectReason  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}
